<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><NuGetAudit>false</NuGetAudit>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Current linked production sources intentionally supersede the previously built host. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <OutputPath>../../artifacts/domain-hopper/bin/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Volibear/Core/DomainHopper*.cs" />
    <Compile Include="../../src/Volibear/Presentation/PowerPresentationDomain.cs" />
    <Compile Include="../../src/Volibear/Core/SummonRegistration.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="AdapterTests.cs" />
    <Reference Include="Volibear"><HintPath>$(HostAssembly)</HintPath></Reference>
    <Reference Include="sts2"><HintPath>$(Sts2DataDir)/sts2.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2DataDir)/GodotSharp.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath></Reference>
    <Reference Include="BaseLib"><HintPath>$(BaseLibPath)</HintPath></Reference>
  </ItemGroup>
</Project>
