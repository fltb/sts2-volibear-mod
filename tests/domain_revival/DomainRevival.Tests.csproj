<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><NuGetAudit>false</NuGetAudit>
    <HostAssembly Condition="'$(HostAssembly)' == ''">../../src/Volibear/bin/Release/net9.0/Volibear.dll</HostAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" /><Compile Include="HostAlias.cs" />
    <Compile Include="../../src/Volibear/Core/DomainRevivalEffects.cs" Link="DomainRevivalEffects.cs" />
    <Compile Include="../../src/Volibear/Core/RevivalDecision.cs" Link="RevivalDecision.cs" />
    <Reference Include="Volibear"><HintPath>$(HostAssembly)</HintPath><Aliases>VolibearHost</Aliases></Reference>
    <Reference Include="sts2"><HintPath>$(Sts2DataDir)/sts2.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2DataDir)/GodotSharp.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath></Reference>
    <Reference Include="BaseLib"><HintPath>../../.local/dependencies/BaseLib-3.4.7/BaseLib.dll</HintPath></Reference>
  </ItemGroup>
</Project>
