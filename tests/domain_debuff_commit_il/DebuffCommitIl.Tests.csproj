<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <RepositoryRoot Condition="'$(RepositoryRoot)' == ''">$(MSBuildProjectDirectory)/../..</RepositoryRoot>
    <BaseLibPath Condition="'$(BaseLibPath)' == ''">$(RepositoryRoot)/.local/dependencies/BaseLib-3.4.7/BaseLib.dll</BaseLibPath>
  </PropertyGroup>
  <!-- Focused native-IL fixture: compiles the current production sources directly and
       emits the real transpilers in the actual install order observed in the full chain. -->
  <ItemGroup>
    <Compile Include="$(RepositoryRoot)/src/Volibear/**/*.cs" Exclude="$(RepositoryRoot)/src/Volibear/bin/**;$(RepositoryRoot)/src/Volibear/obj/**" />
    <Reference Include="sts2"><HintPath>$(Sts2DataDir)/sts2.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2DataDir)/GodotSharp.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath></Reference>
    <Reference Include="BaseLib"><HintPath>$(BaseLibPath)</HintPath></Reference>
  </ItemGroup>
</Project>
